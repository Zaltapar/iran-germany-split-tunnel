# xray-consumer.service
[Unit]
Description=Xray core (Iran up-carrier consumer, VLESS+Reality)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=split-tunnel
Group=split-tunnel
ExecStart=/opt/split-tunnel/xray/current/xray run -config /etc/split-tunnel/xray-consumer.json
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=23
LimitNOFILE=100000
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/log/split-tunnel
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xray-consumer

[Install]
WantedBy=multi-user.target
