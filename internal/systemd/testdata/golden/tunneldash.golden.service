# tunneldash.service
[Unit]
Description=Split-tunnel monitoring dashboard (tunneldash)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=split-tunnel
Group=split-tunnel
EnvironmentFile=/etc/split-tunnel/dashboard.env
ExecStart=/opt/split-tunnel/tunneldash -config /etc/split-tunnel/dashboard/config.json
Restart=always
RestartSec=5
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTun=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=user
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
ReadWritePaths=/var/log/split-tunnel
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tunneldash

[Install]
WantedBy=multi-user.target
