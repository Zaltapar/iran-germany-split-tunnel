[Unit]
Description=germany-splitter - up-carrier WS client, down-carrier TCP listener, internet dialer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/germany-splitter
Restart=always
RestartSec=5

# Up-carrier WebSocket URL - your CDN domain (this node dials Iran's WS server)
Environment=SPLIT_UP_WS_URL=wss://up.domain.com/upload
# Down-carrier TCP listener - Iran reaches it via VLESS+Reality
Environment=SPLIT_DOWN_LISTEN=0.0.0.0:9002
# Must match SPLIT_SECRET on the Iran node
Environment=SPLIT_SECRET=YOUR-SECRET-HERE
# Optional:
#Environment=SPLIT_METRICS_PORT=9101
#Environment=SPLIT_RELAY_BUF=32768

LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=germany-splitter

[Install]
WantedBy=multi-user.target