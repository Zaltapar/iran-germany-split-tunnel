[Unit]
Description=Germany Splitter Daemon (WS Up-Dialer + TCP Down-Listener)
After=network.target xray.service

[Service]
Type=simple
ExecStart=/usr/local/bin/germany-splitter
Restart=always
RestartSec=5
Environment=SPLIT_DOWN_LISTEN=:9002
Environment=SPLIT_UP_WS_URL=wss://cdn.example.com/upload
Environment=SPLIT_SECRET=YOUR-SECRET-HERE
Environment=SPLIT_METRICS_PORT=9101
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=germany-splitter

[Install]
WantedBy=multi-user.target
