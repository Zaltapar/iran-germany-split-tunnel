[Unit]
Description=Germany Splitter Daemon (Asymmetric Split-Tunnel)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/germany-splitter
Restart=always
RestartSec=5
Environment=SPLIT_UP_WS_URL=wss://cdn.example.com/upload
Environment=SPLIT_DOWN_LISTEN=:9002
Environment=SPLIT_SECRET=CHANGE-ME-SECRET
Environment=SPLIT_METRICS_PORT=9100
Environment=SPLIT_RELAY_BUF=32768
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=germany-splitter

[Install]
WantedBy=multi-user.target
