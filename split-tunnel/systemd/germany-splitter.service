[Unit]
Description=Germany Splitter Daemon
After=network.target xray.service

[Service]
Type=simple
ExecStart=/usr/local/bin/germany-splitter
Restart=always
RestartSec=5
Environment=SPLIT_LISTEN=:9000
Environment=SPLIT_SECRET=YOUR-SECRET-HERE
Environment=SPLIT_METRICS_PORT=9101
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=germany-splitter

[Install]
WantedBy=multi-user.target
