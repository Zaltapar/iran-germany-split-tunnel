[Unit]
Description=Iran Splitter Daemon
After=network.target xray.service

[Service]
Type=simple
ExecStart=/usr/local/bin/iran-splitter
Restart=always
RestartSec=5
Environment=SPLIT_LISTEN=127.0.0.1:10900
Environment=SPLIT_CARRIER=germany-server:9000
Environment=SPLIT_SECRET=YOUR-SECRET-HERE
Environment=SPLIT_METRICS_PORT=9100
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iran-splitter

[Install]
WantedBy=multi-user.target
