[Unit]
Description=Iran Splitter Daemon (Asymmetric Split-Tunnel)
After=network.target
Wants=xray.service

[Service]
Type=simple
ExecStart=/usr/local/bin/iran-splitter
Restart=always
RestartSec=5
Environment=SPLIT_SOCKS_LISTEN=127.0.0.1:10900
Environment=SPLIT_WS_LISTEN=127.0.0.1:9001
Environment=SPLIT_DOWN_CARRIER_ADDR=127.0.0.1:10802
Environment=SPLIT_SECRET=CHANGE-ME-SECRET
Environment=SPLIT_METRICS_PORT=9100
Environment=SPLIT_RELAY_BUF=32768
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iran-splitter

[Install]
WantedBy=multi-user.target
