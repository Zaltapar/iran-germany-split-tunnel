[Unit]
Description=Iran Splitter Daemon
After=network.target xray.service

[Service]
Type=simple
ExecStart=/usr/local/bin/iran-splitter
Restart=always
RestartSec=5
Environment=SPLIT_LISTEN=127.0.0.1:10900
Environment=SPLIT_UP_SOCKS=127.0.0.1:10801
Environment=SPLIT_DOWN_SOCKS=127.0.0.1:10802
Environment=SPLIT_METRICS_PORT=9100
Environment=SPLIT_RELAY_BUF=32768
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iran-splitter

[Install]
WantedBy=multi-user.target
