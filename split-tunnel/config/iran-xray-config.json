{
  "inbounds": [
    {
      "tag": "user-vless-reality",
      "port": 443,
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "YOUR-UUID" }]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "certificates": [
            {
              "certificateFile": "/etc/letsencrypt/live/example.com/fullchain.pem",
              "keyFile": "/etc/letsencrypt/live/example.com/privkey.pem"
            }
          ]
        }
      }
    }
  ],
  "outbounds": [
    { "tag": "up-cdn", "protocol": "freedom" },
    { "tag": "down-direct", "protocol": "freedom" },
    {
      "tag": "to-splitter",
      "protocol": "socks",
      "settings": {
        "servers": [{ "address": "127.0.0.1", "port": 10900 }]
      }
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "inboundTag": ["user-vless-reality"],
        "outboundTag": "to-splitter"
      }
    ]
  }
}
