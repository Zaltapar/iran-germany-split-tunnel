{
  "inbounds": [
    {
      "tag": "up-cdn-inbound",
      "port": 9001,
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "YOUR-UUID" }]
      },
      "streamSettings": {
        "network": "ws",
        "wsSettings": { "path": "/upload" }
      }
    },
    {
      "tag": "down-direct-inbound",
      "port": 9002,
      "protocol": "vless",
      "settings": {
        "clients": [{ "id": "YOUR-UUID" }]
      },
      "streamSettings": {
        "network": "tcp"
      }
    }
  ],
  "outbounds": [
    {
      "tag": "to-up-listener",
      "protocol": "socks",
      "settings": { "servers": [{ "address": "127.0.0.1", "port": 10901 }] }
    },
    {
      "tag": "to-down-listener",
      "protocol": "socks",
      "settings": { "servers": [{ "address": "127.0.0.1", "port": 10902 }] }
    }
  ],
  "routing": {
    "rules": [
      {
        "type": "field",
        "inboundTag": ["up-cdn-inbound"],
        "outboundTag": "to-up-listener"
      },
      {
        "type": "field",
        "inboundTag": ["down-direct-inbound"],
        "outboundTag": "to-down-listener"
      }
    ]
  }
}
