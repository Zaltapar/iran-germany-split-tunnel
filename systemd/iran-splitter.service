[Unit]
Description=iran-splitter - SOCKS5 entry, up-carrier WS server, down-carrier dialer
After=network-online.target xray.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/iran-splitter
Restart=always
RestartSec=5

# SOCKS5 listener - the local Xray routes client traffic here
Environment=SPLIT_SOCKS_LISTEN=127.0.0.1:10900
# Up-carrier WebSocket server - front it with nginx -> CDN (path /upload)
Environment=SPLIT_WS_LISTEN=127.0.0.1:9001
# Down-carrier dial target - local Xray VLESS+Reality outbound port
Environment=SPLIT_DOWN_CARRIER_ADDR=127.0.0.1:10802
# MUST match SPLIT_SECRET on the Germany node. The shipped placeholder
# below is REJECTED at startup (Phase 6 policy) - replace it, e.g.:
#   openssl rand -hex 32
Environment=SPLIT_SECRET=YOUR-SECRET-HERE
# Optional (defaults shown):
#Environment=SPLIT_METRICS_PORT=9100
#Environment=SPLIT_RELAY_BUF=32768
#Environment=SPLIT_STREAM_QUEUE_BYTES=0
#Environment=SPLIT_STREAM_QUEUE_FRAMES=0
#Environment=SPLIT_STREAM_QUEUE_TOTAL_BYTES=0
#Environment=SPLIT_STREAM_OVERFLOW_MS=0
#Environment=SPLIT_CARRIER_GRACE=5000
#Environment=SPLIT_BOOTSTRAP_WAIT_MS=0
#Environment=SPLIT_SESSION_BUFFER_BYTES=262144
#Environment=SPLIT_SESSION_BUFFER_TOTAL_BYTES=0
#Environment=SPLIT_LIVENESS_ROUNDS=0

LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iran-splitter

[Install]
WantedBy=multi-user.target