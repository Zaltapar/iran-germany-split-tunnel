[Unit]
Description=germany-splitter - up-carrier WS client, down-carrier TCP listener, internet dialer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/germany-splitter
Restart=always
RestartSec=5

# Up-carrier WebSocket URL - your CDN domain (this node dials Iran's WS
# server). The shipped placeholder below is REJECTED at startup (Phase 7)
# - replace it with your real CDN up-carrier URL, e.g.:
#   SPLIT_UP_WS_URL=wss://your-cdn-domain.com/upload
Environment=SPLIT_UP_WS_URL=wss://up.domain.com/upload
# Down-carrier TCP listener - Iran reaches it via VLESS+Reality
# (bare :port binds all interfaces; matches the code default)
Environment=SPLIT_DOWN_LISTEN=:9002
# MUST match SPLIT_SECRET on the Iran node. The shipped placeholder below
# is REJECTED at startup (Phase 6 policy) - replace it, e.g.:
#   openssl rand -hex 32
Environment=SPLIT_SECRET=YOUR-SECRET-HERE
# Optional (defaults shown):
#Environment=SPLIT_METRICS_PORT=9101
#Environment=SPLIT_RELAY_BUF=32768
#Environment=SPLIT_STREAM_QUEUE_BYTES=0
#Environment=SPLIT_STREAM_QUEUE_FRAMES=0
#Environment=SPLIT_STREAM_QUEUE_TOTAL_BYTES=0
#Environment=SPLIT_STREAM_OVERFLOW_MS=0
#Environment=SPLIT_CARRIER_GRACE=5000
#Environment=SPLIT_BOOTSTRAP_WAIT_MS=0
#Environment=SPLIT_SESSION_BUFFER_BYTES=262144
#Environment=SPLIT_SESSION_BUFFER_TOTAL_BYTES=0
#Environment=SPLIT_LIVENESS_ROUNDS=0

LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=germany-splitter

[Install]
WantedBy=multi-user.target